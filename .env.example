# Environment variables for Review Watchdog Frontend
# Copy this file to .env and replace with your actual API keys

# Google Places API Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
# Enable Places API (New) and Geocoding API in your Google Cloud Console
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Outscraper API Configuration  
# Get your API key from: https://app.outscraper.cloud/api-key
# Used for comprehensive business review fetching
VITE_OUTSCRAPER_API_KEY=your_outscraper_api_key_here